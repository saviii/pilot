{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(make verify)",
      "Bash(make generate)",
      "Bash(make format)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make shots)",
      "Bash(make phone)",
      "Bash(xcodegen generate:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcrun devicectl list:*)",
      "Bash(xcrun devicectl device info:*)",
      "Bash(xcrun devicectl device copy from:*)",
      "Bash(swift test:*)",
      "Bash(swift build:*)",
      "Bash(swift format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(TVRemote.xcodeproj/**)",
      "Write(TVRemote.xcodeproj/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh", "timeout": 600 }]
      }
    ]
  }
}
